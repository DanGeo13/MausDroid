{
  "manifest_version": 3,
  "name": "Screen Helper",
  "version": "0.5.0",
  "description": "Sign in with ChatGPT, then ChatGPT reads the current tab and answers the questions on it.",
  "permissions": ["sidePanel", "storage", "tabs", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Screen Helper" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Open Screen Helper"
    }
  }
}
