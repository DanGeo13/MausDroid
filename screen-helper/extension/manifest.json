{
  "manifest_version": 3,
  "name": "Screen Helper",
  "version": "0.3.0",
  "description": "Screenshots the current tab and sends it to ChatGPT, ready for you to paste and send.",
  "permissions": ["activeTab", "clipboardWrite", "storage"],
  "action": { "default_title": "Screen Helper", "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["https://chatgpt.com/*"], "js": ["chatgpt.js"], "run_at": "document_idle" }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Screenshot this tab for ChatGPT"
    }
  }
}
